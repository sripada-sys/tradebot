# =============================================================
# TradeBot Stack — .env template
# Copy to `.env` on the server and fill in real values.
# Generate secrets with: openssl rand -hex 32
# =============================================================

# ---------- shared ----------
TZ=Asia/Kolkata

# ---------- Postgres ----------
POSTGRES_USER=stackadmin
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=n8n

N8N_DB=n8n
EVO_DB=evolution

# ---------- n8n ----------
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
N8N_HOST=YOUR_SERVER_IP_OR_DOMAIN
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://YOUR_SERVER_IP:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_strong_password

# ---------- Evolution API ----------
EVOLUTION_API_KEY=CHANGE_ME_openssl_rand_hex_24
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_INSTANCE=YOUR_EVOLUTION_INSTANCE
HEALTH_REPORT_WHATSAPP=COUNTRYCODE_AND_NUMBER

# ---------- Fyers (Phase 3+) ----------
# FYERS_APP_ID=
# FYERS_SECRET_KEY=
# FYERS_REDIRECT_URI=http://YOUR_SERVER_IP/fyers/callback
# FYERS_TOTP_SECRET=
# FYERS_PIN=

# ---------- LLM (Phase 2+) ----------
OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
